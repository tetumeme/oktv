{
  "sites": [
    {
      "key": "123av",
      "name": "123AV 中文",
      "jar": "https://clun.top/jar/gm.jar",
      "type": 3,
      "quickSearch": 1,
      "searchable": 1,
      "changeable": 0,
      "filterable": 1,
      "timeout": 60,
      "style": {
        "type": "rect",
        "ratio": 1.49
      },
      "api": "csp_GM",
      "ext": {
        "userScript": "https://cdn.jsdelivr.net/gh/tetumeme/oktv@main/123av.user.js",
        "debug": false,
        "webViewSettings": {
          "blockNetworkImage": true,
          "blockList": [
            "*.ico",
            "*.png",
            "*.jpg",
            "*.vtt",
            "*.css*",
            "https://*.googleapis.com/*",
            "https://*.googletagmanager.com/*",
            "https://*.google-analytics.com/*",
            "https://*.recombee.com/*",
            "https://*.magsrv.com/*",
            "https://*.pemsrv.com/*",
            "https://*.amung.us/*"
          ]
        },
        "playUrlMatch": [
          "https://*/video.m3u8*",
          "https://*/v.m3u8*"
        ],
        "spider": {
          "homeContent": {
            "loadUrl": "https://123av.com/cn"
          },
          "categoryContent": {
            "loadUrl": "https://123av.com/cn/${tid}?page=${pg:-1}${filter:-}"
          },
          "detailContent": {
            "loadUrl": "https://123av.com/cn/v/${id}"
          },
          "playerContent": {
            "loadUrl": "https://123av.com/cn/v/${vod_id}"
          },
          "searchContent": {
            "loadUrl": "https://123av.com/cn/search?keyword=${key}&page=${pg:-1}"
          }
        }
      }
    }
  ]
}
